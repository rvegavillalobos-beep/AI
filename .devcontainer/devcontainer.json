{
  "name": "ST020 Corner Analytics",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "streamlit_app.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo '✅ Requirements installed'",
  "postAttachCommand": {
    "server": "streamlit run streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {"label": "ST020 Corner Analytics", "onAutoForward": "openPreview"}
  },
  "forwardPorts": [8501]
}
